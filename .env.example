# Origin of the umbrella-api backend. Server-side only: consumed by the
# /api/:path* rewrite in next.config.ts. Never prefix with NEXT_PUBLIC_.
API_ORIGIN=http://localhost:8000

# Public TestFlight invite link. Client-side: inlined into the bundle at build
# time, which is fine — the URL is the invitation. Leave unset until a real
# link exists; every TestFlight CTA hides itself while it is empty.
NEXT_PUBLIC_TESTFLIGHT_URL=
